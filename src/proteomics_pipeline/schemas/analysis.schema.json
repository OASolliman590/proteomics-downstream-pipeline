{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proteomics-downstream:analysis:1.2.0",
  "title": "Analysis configuration — frozen preimplementation v1.2.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "study": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "experimental_unit": {
          "type": "string",
          "minLength": 1
        },
        "design_evidence": {
          "enum": [
            "documented",
            "unknown",
            "synthetic"
          ]
        },
        "tissue": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "experimental_unit",
        "design_evidence",
        "tissue"
      ],
      "additionalProperties": false
    },
    "assay": {
      "enum": [
        "lfq_dda",
        "lfq_dia",
        "tmt",
        "processed_protein"
      ]
    },
    "source_scale": {
      "enum": [
        "linear_positive",
        "log2",
        "ratio_log2",
        "standardized_unknown"
      ]
    },
    "organism": {
      "type": "object",
      "properties": {
        "taxonomy_id": {
          "type": "integer",
          "minimum": 1
        },
        "scientific_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "taxonomy_id",
        "scientific_name"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "matrix": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "wide_tsv",
            "long_tsv",
            "mapped_protein",
            "legacy_workbook"
          ]
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "mapping": {
          "type": "string",
          "minLength": 1
        },
        "observations": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "type": "string",
          "minLength": 1
        },
        "normalization_state": {
          "enum": [
            "normalized_documented",
            "unnormalized_documented",
            "unknown"
          ]
        },
        "prior_imputation": {
          "enum": [
            "none_documented",
            "mask_available",
            "unknown"
          ]
        },
        "missing_values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "linear_zero_as_missing": {
          "type": "boolean"
        },
        "original_observed_mask": {
          "type": [
            "string",
            "null"
          ]
        },
        "prior_imputed_mask": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_provenance": {
          "type": "string",
          "minLength": 1
        },
        "ratio_reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "matrix",
        "format",
        "profile",
        "observations",
        "features",
        "normalization_state",
        "prior_imputation",
        "missing_values",
        "linear_zero_as_missing",
        "original_observed_mask",
        "prior_imputed_mask",
        "source_provenance"
      ],
      "additionalProperties": false
    },
    "preprocessing": {
      "type": "object",
      "properties": {
        "transform": {
          "enum": [
            "none",
            "log2"
          ]
        },
        "normalization": {
          "enum": [
            "preserve",
            "median",
            "reference",
            "tmt_loading"
          ]
        },
        "normalization_sensitivities": {
          "type": "array",
          "items": {
            "enum": [
              "quantile"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "reference_features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reference_minimum_fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "technical_replicates": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "none",
                "aggregate"
              ]
            },
            "method": {
              "enum": [
                "mean_linear",
                "mean_log2"
              ]
            },
            "biological_unit_column": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mode",
            "biological_unit_column"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "aggregate"
                  }
                }
              },
              "then": {
                "required": [
                  "method"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "none"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "method"
                  ]
                }
              }
            }
          ]
        },
        "new_primary_imputation": {
          "const": "none"
        },
        "tmt_strategy": {
          "enum": [
            "upstream_preserved",
            "bridge",
            "no_bridge"
          ]
        },
        "bridge_channel_column": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exclusion"
          },
          "minItems": 0
        },
        "sensitivities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sensitivity"
          },
          "minItems": 0
        },
        "detection_enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "transform",
        "normalization",
        "technical_replicates",
        "new_primary_imputation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "normalization": {
                "const": "reference"
              }
            }
          },
          "then": {
            "required": [
              "reference_features",
              "reference_minimum_fraction"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "tmt_strategy": {
                "const": "bridge"
              }
            },
            "required": [
              "tmt_strategy"
            ]
          },
          "then": {
            "required": [
              "bridge_channel_column"
            ]
          }
        }
      ]
    },
    "design": {
      "$ref": "#/$defs/design"
    },
    "additional_designs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/design"
      },
      "minItems": 0
    },
    "contrasts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contrast"
      },
      "minItems": 1
    },
    "primary_engine": {
      "enum": [
        "limma",
        "deqms",
        "proda"
      ],
      "default": "limma"
    },
    "primary_hypothesis": {
      "enum": [
        "zero_null",
        "treat"
      ],
      "default": "zero_null"
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      },
      "minItems": 1,
      "contains": {
        "properties": {
          "role": {
            "const": "primary"
          }
        },
        "required": [
          "role"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "multiplicity_families": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/family"
      },
      "minItems": 1
    },
    "omnibus_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "model_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "coefficient_names": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reduced_design_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          }
        },
        "required": [
          "id",
          "model_id",
          "coefficient_names"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      },
      "minItems": 0
    },
    "pathways": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "methods": {
          "type": "array",
          "items": {
            "enum": [
              "camera",
              "roast",
              "fgsea",
              "ora"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "mapping_resource_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "gene_set_resource_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "representative_rule": {
          "const": "coverage_median_stable_id"
        },
        "multi_gene_policy": {
          "const": "exclude"
        },
        "gene_aggregation_sensitivity": {
          "enum": [
            "off",
            "median"
          ]
        },
        "min_size": {
          "type": "integer",
          "minimum": 1
        },
        "max_size": {
          "type": "integer",
          "minimum": 1
        },
        "nrot": {
          "type": "integer",
          "minimum": 1
        },
        "midp": {
          "const": false
        },
        "rank": {
          "enum": [
            "native_zero_null",
            "signed_logp_legacy"
          ]
        },
        "eps": {
          "type": "number",
          "minimum": 0
        },
        "linear_sensitivity_model_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "ora_foreground": {
          "enum": [
            "family_q",
            "raw_p_exploratory"
          ]
        },
        "ora_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "methods",
              "mapping_resource_id",
              "gene_set_resource_ids",
              "representative_rule",
              "multi_gene_policy",
              "min_size",
              "max_size"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "methods": {
                "contains": {
                  "const": "roast"
                }
              }
            },
            "required": [
              "methods"
            ]
          },
          "then": {
            "required": [
              "nrot",
              "midp"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "methods": {
                "contains": {
                  "const": "fgsea"
                }
              }
            },
            "required": [
              "methods"
            ]
          },
          "then": {
            "required": [
              "rank",
              "eps"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "methods": {
                "contains": {
                  "const": "ora"
                }
              }
            },
            "required": [
              "methods"
            ]
          },
          "then": {
            "required": [
              "ora_foreground",
              "ora_threshold"
            ]
          }
        }
      ]
    },
    "response_mode": {
      "enum": [
        "descriptive_only",
        "equivalence",
        "formal_rescue"
      ],
      "default": "descriptive_only"
    },
    "score_test": {
      "enum": [
        "off",
        "independent_exact",
        "independent_monte_carlo"
      ],
      "default": "off"
    },
    "response": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "axes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/axis"
          },
          "minItems": 1
        },
        "selection": {
          "enum": [
            "all_eligible",
            "raw_p_display_only"
          ]
        },
        "ri_minimum_abs_disease_effect": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ratio_uncertainty": {
          "enum": [
            "descriptive_only",
            "fieller"
          ]
        },
        "equivalence_margin": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.25
        },
        "direction_resource_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "disease_margin": {
          "type": "number",
          "minimum": 0
        },
        "treatment_margin": {
          "type": "number",
          "minimum": 0
        },
        "scores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/score"
          },
          "minItems": 0
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "axes",
              "selection",
              "ri_minimum_abs_disease_effect",
              "ratio_uncertainty"
            ]
          }
        }
      ]
    },
    "runtime": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "threads": {
          "type": "integer",
          "minimum": 1
        },
        "network": {
          "const": "offline"
        },
        "overwrite": {
          "const": false
        },
        "execution_profile": {
          "enum": [
            "production",
            "smoke_test"
          ]
        },
        "scope": {
          "enum": [
            "analysis",
            "qc_only"
          ]
        },
        "phase": {
          "enum": [
            1,
            2,
            3
          ]
        }
      },
      "required": [
        "seed",
        "threads",
        "network",
        "overwrite",
        "execution_profile",
        "scope",
        "phase"
      ],
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "properties": {
        "html": {
          "const": true
        },
        "figure_formats": {
          "type": "array",
          "items": {
            "enum": [
              "pdf",
              "svg",
              "png"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "ci_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "include_all_planned_contrasts": {
          "const": true
        },
        "public_path_redaction": {
          "const": true
        }
      },
      "required": [
        "html",
        "figure_formats",
        "ci_level",
        "include_all_planned_contrasts",
        "public_path_redaction"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "study",
    "assay",
    "source_scale",
    "organism",
    "input",
    "preprocessing",
    "design",
    "contrasts",
    "primary_engine",
    "primary_hypothesis",
    "models",
    "multiplicity_families",
    "resources",
    "pathways",
    "response_mode",
    "response",
    "runtime",
    "report"
  ],
  "additionalProperties": false,
  "$defs": {
    "blocking": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "none",
            "fixed_subject",
            "duplicate_correlation"
          ]
        },
        "subject_column": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "none"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "subject_column"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "fixed_subject",
                  "duplicate_correlation"
                ]
              }
            }
          },
          "then": {
            "required": [
              "subject_column"
            ]
          }
        }
      ]
    },
    "design": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "group_column": {
          "type": "string",
          "minLength": 1
        },
        "group_levels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "continuous_covariates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "column": {
                "type": "string",
                "minLength": 1
              },
              "center": {
                "type": "boolean"
              }
            },
            "required": [
              "column",
              "center"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "categorical_covariates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "column": {
                "type": "string",
                "minLength": 1
              },
              "levels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 2,
                "uniqueItems": true
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "column",
              "levels",
              "reference"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "interactions": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "uniqueItems": true
          },
          "minItems": 0
        },
        "intercept": {
          "type": "boolean"
        },
        "blocking": {
          "$ref": "#/$defs/blocking"
        }
      },
      "required": [
        "id",
        "group_column",
        "group_levels",
        "continuous_covariates",
        "categorical_covariates",
        "interactions",
        "intercept",
        "blocking"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "policy": {
          "enum": [
            "available_case",
            "native_dropout"
          ]
        },
        "minimum_observed_per_group": {
          "type": "integer",
          "minimum": 2
        },
        "minimum_fraction": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1
        },
        "mask_source": {
          "const": "original_observed"
        }
      },
      "required": [
        "policy",
        "mask_source"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "policy": {
                "const": "available_case"
              }
            }
          },
          "then": {
            "required": [
              "minimum_observed_per_group",
              "minimum_fraction"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "const": "native_dropout"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "minimum_observed_per_group"
                  ]
                },
                {
                  "required": [
                    "minimum_fraction"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "design_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "engine": {
          "enum": [
            "limma",
            "deqms",
            "proda"
          ]
        },
        "role": {
          "enum": [
            "primary",
            "sensitivity"
          ]
        },
        "execution_requirement": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "hypothesis": {
          "enum": [
            "zero_null",
            "treat"
          ]
        },
        "additional_hypotheses": {
          "type": "array",
          "items": {
            "enum": [
              "zero_null",
              "treat"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "effect_threshold": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "trend": {
          "type": "boolean"
        },
        "robust": {
          "type": "boolean"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "count_evidence": {
          "type": "string",
          "minLength": 1
        },
        "count_aggregation": {
          "enum": [
            "protein_level",
            "minimum_across_observations",
            "minimum_across_plexes"
          ]
        },
        "count_zero_policy": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "reject",
                "explicit_offset"
              ]
            },
            "offset": {
              "type": "number",
              "exclusiveMinimum": 0
            },
