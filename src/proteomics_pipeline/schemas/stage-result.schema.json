{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proteomics-downstream:stage-result:1.2.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "stage_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "plan_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "NOT_RUN",
        "RUNNING",
        "COMPLETED",
        "INAPPLICABLE",
        "FAILED",
        "CANCELLED",
        "NOT_REQUESTED"
      ]
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": "string"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "result_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "artifact_id",
          "relative_path",
          "sha256",
          "result_type"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "stage_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "artifact_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "stage_id",
          "severity",
          "message",
          "artifact_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "session_info_path": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "stage_id",
    "capability",
    "plan_hash",
    "state",
    "reason_code",
    "message",
    "started_at",
    "finished_at",
    "exit_code",
    "outputs",
    "warnings",
    "session_info_path"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "COMPLETED"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          },
          "reason_code": {
            "type": "null"
          },
          "finished_at": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "NOT_RUN",
              "FAILED",
              "INAPPLICABLE",
              "CANCELLED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reason_code": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
